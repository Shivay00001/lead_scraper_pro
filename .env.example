# Lead Scraper Pro - Environment Configuration
# Copy to .env and adjust. All values below are defaults/placeholders.
# NEVER commit a real .env file (it is in .gitignore).

# ---- Database ----
# Path to the SQLite database file. Defaults to ~/.lead_scraper_pro/leads.db
# LSP_DB_PATH=./data/leads.db

# ---- Encryption ----
# Key material for field-level lead encryption (Fernet key derived via PBKDF2).
# If unset, a random per-user key is generated once and stored at
# ~/.lead_scraper_pro/encryption.key (mode 600).
# Set this explicitly in shared/server deployments so restarts and containers
# can decrypt the same database. Use a long random value (32+ chars).
# LSP_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# ---- License server ----
# Base URL for online license validation. The embedded plan limits apply
# offline; this URL is only used for server-side key checks.
# LSP_LICENSE_SERVER_URL=https://api.leadscraperpro.com/v1/license

# ---- Revocation list ----
# URL of a plain-text file listing revoked license keys, one per line.
# Leave EMPTY to disable the remote revocation check entirely.
# LSP_REVOCATION_URL=

# ---- License signing key ----
# Path to a PEM public key file that replaces the embedded demo key used
# for license signature verification. Generate keys with: python admin_keygen.py
# LSP_PUBLIC_KEY_PATH=./public_key.pem
